---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-heading">
  <span class="eyebrow">{eyebrow}</span>
  <h1>
    {title}
    <span class="title-dot">.</span>
  </h1>
  <p>{description}</p>
</header>
