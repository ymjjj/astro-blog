<dialog
  id="image-viewer"
  class="image-viewer"
  aria-labelledby="image-viewer-title"
  aria-describedby="image-viewer-caption"
>
  <div class="image-viewer-toolbar">
    <h2 id="image-viewer-title">图片查看器</h2>
    <button type="button" class="viewer-close" aria-label="关闭图片查看器">
      关闭 <span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="image-viewer-stage"></div>
  <p id="image-viewer-caption"></p>
</dialog>
<p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
<script>
  import '../scripts/reading-tools';
</script>
