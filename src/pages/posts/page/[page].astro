---
import type { CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHeading from '../../../components/PageHeading.astro';
import PostList from '../../../components/PostList.astro';
import { published } from '../../../lib/content';
import { PAGE_SIZE, pageCount } from '../../../lib/pagination';

interface Props {
  posts: CollectionEntry<'posts'>[];
  totalCount: number;
  currentPage: number;
  totalPages: number;
}

export async function getStaticPaths() {
  const { posts } = await published();
  const totalPages = pageCount(posts.length);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * PAGE_SIZE;

    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + PAGE_SIZE),
        totalCount: posts.length,
        currentPage,
        totalPages,
      },
    };
  });
}

const { posts, totalCount, currentPage, totalPages } = Astro.props;
---

<Base title="文章" active="posts">
  <div class="narrow-page">
    <PageHeading
      eyebrow="THE NOTEBOOK"
      title="慢慢写下来的事"
      description="整理知识，也整理思绪。这里收着每一篇认真写下的笔记。"
    />
    <PostList
      posts={posts}
      totalCount={totalCount}
      currentPage={currentPage}
      totalPages={totalPages}
    />
  </div>
</Base>
