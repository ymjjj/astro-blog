---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readable, url, formatDate, tagUrl, readingTime } from '../../lib/content';
import DraftBanner from '../../components/DraftBanner.astro';
import UpdatedDate from '../../components/UpdatedDate.astro';
export async function getStaticPaths() {
  return (await readable()).posts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  active="posts"
  articleDate={entry.data.date}
  modifiedDate={entry.data.updated}
  noindex={entry.data.draft}
>
  {entry.data.draft && <DraftBanner />}
  <div class="article-shell">
    <article class="article-main">
      <a class="back-link" href={url('posts/')}>
        ← 回到文章
      </a>
      <header class="article-heading">
        <div class="eyebrow">THE NOTEBOOK</div>
        <h1>{entry.data.title}</h1>
        <div class="post-meta">
          <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          <span>·</span>
          <span>{readingTime(entry)} 分钟阅读</span>
          <UpdatedDate updated={entry.data.updated} />
        </div>
        <p class="article-description">{entry.data.description}</p>
        <div class="tags">
          {entry.data.tags.map((tag) =>
            entry.data.draft ? (
              <span class="draft-tag"># {tag}</span>
            ) : (
              <a href={tagUrl(tag)}># {tag}</a>
            ),
          )}
        </div>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="article-end">
        <span aria-hidden="true">✦</span>
        <p>谢谢你读到这里。</p>
        <a href={url('posts/')}>继续翻翻其他笔记 →</a>
      </footer>
    </article>
    {toc.length > 0 && (
      <aside class="toc" aria-label="文章目录">
        <details open>
          <summary>本篇目录</summary>
          <nav>
            {toc.map((heading) => (
              <a class:list={[{ 'toc-sub': heading.depth === 3 }]} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      </aside>
    )}
  </div>
</Base>
