{
  "name": "between-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build --force",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "verify": "node scripts/verify-build.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "new": "node scripts/new-content.mjs",
    "format": "prettier --write .",
