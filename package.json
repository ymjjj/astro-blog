    "test:tools": "node --test tests/tools/*.test.mjs",
    "verify:complete": "node scripts/verify-complete.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/rss": "4.0.19",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "astro": "7.3.5",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "cheerio": "^1.2.0",
